{\n        \"type\": \"asset\",\n        \"asset\": \"welcome-panel\"\n      },\n      \"transform\": {\n        \"position\": [0, 1.6, -2],\n        \"scale\": 0.4\n      },\n      \"components\": {\n        \"RayInteractable\": {},\n        \"ScreenSpace\": {\n          \"top\": \"20px\",\n          \"left\": \"20px\",\n          \"width\": \"25vw\",\n          \"height\": \"40%\"\n        }\n      }\n    },\n    {\n      \"id\": \"webxr-banner\",\n      \"name\": \"WebXR Banner\",\n      \"content\": {\n        \"type\": \"asset\",\n        \"asset\": \"webxr-banner\"\n      },\n      \"transform\": {\n        \"position\": [0, 1, 1.8],\n        \"rotationDeg\": [0, 180, 0],\n        \"scale\": [1, -1, 1]\n      },\n      \"components\": {}\n    }\n  ]\n}\n",
