  \"path\": \"registry.json\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/registry.json\"\n        },\n        {\n          \"path\": \"src/index.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/index.ts\"\n        },\n        {\n          \"path\": \"src/assets.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/assets.ts\"\n        },\n        {\n          \"path\": \"src/components.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/components.ts\"\n        },\n        {\n          \"path\": \"src/panel.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/panel.ts\"\n        },\n        {\n          \"path\": \"src/robot.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/robot.ts\"\n        },\n        {\n          \"path\": \"src/robot-component.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/robot-component.ts\"\n        },\n        {\n          \"path\": \"src/vite-env.d.ts\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/vite-env.d.ts\"\n        },\n        {\n          \"path\": \"src/AGENTS.md\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/src/AGENTS.md\"\n        },\n        {\n          \"path\": \"public/scenes/main.iwsdk.scene.json\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/scenes/main.iwsdk.scene.json\"\n        },\n        {\n          \"path\": \"public/scenes/AGENTS.md\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/scenes/AGENTS.md\"\n        },\n        {\n          \"path\": \"public/ui/welcome.uikitml\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/ui/welcome.uikitml\"\n        },\n        {\n          \"path\": \"public/ui/AGENTS.md\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/ui/AGENTS.md\"\n        },\n        {\n          \"path\": \"public/audio/chime.mp3\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/audio/chime.mp3\"\n        },\n        {\n          \"path\": \"public/textures/webxr.png\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/textures/webxr.png\"\n        },\n        {\n          \"path\": \"public/gltf/webxr-banner/banner.gltf\",\n          \"type\": \"registry:file\",\n          \"target\": \"~/public/gltf/webxr-banner/banner.gltf\"\n        }\n      ]\n    }\n  ]\n}\n",
