    {
      "path": "package.json",
      "content": "{\n  \"name\": \"iwsdk-template\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"IWSDK_DEV_OPEN=false IWSDK_DEV_HTTPS=false vite\",\n    \"dev:open\": \"iwsdk dev up --open --foreground\",\n    \"dev:runtime\": \"IWSDK_DEV_OPEN=false IWSDK_DEV_HTTPS=false vite\",\n    \"dev:down\": \"iwsdk dev down\",\n    \"dev:status\": \"iwsdk dev status\",\n    \"reference:status\": \"iwsdk reference status\",\n    \"reference:warmup\": \"iwsdk reference warmup\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"registry:build\": \"pnpm dlx shadcn@latest build\",\n    \"build\": \"pnpm run registry:build && vite build\",\n    \"preview\": \"vite preview\"\n  },\n  \"dependencies\": {\n    \"@iwsdk/core\": \"0.5.1\",\n    \"three\": \"npm:super-three@0.181.0\"\n  },\n  \"devDependencies\": {\n    \"@iwsdk/reference\": \"0.5.1\",\n    \"@iwsdk/cli\": \"0.5.1\",\n    \"@iwsdk/vite-plugin-dev\": \"0.5.1\",\n    \"@meta-quest/metavr\": \"^1.3.2\",\n    \"@types/three\": \"^0.181.0\",\n    \"typescript\": \"^5.5.0\",\n    \"vite\": \"^7.1.4\"\n  },\n  \"pnpm\": {\n    \"overrides\": {\n      \"sharp\": \"0.35.3\"\n    },\n    \"onlyBuiltDependencies\": [\n      \"@meta-quest/metavr\",\n      \"esbuild\",\n      \"onnxruntime-node\",\n      \"protobufjs\",\n      \"sharp\"\n    ]\n  },\n  \"engines\": {\n    \"node\": \">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0\"\n  },\n  \"packageManager\": \"pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7\"\n}\n",
