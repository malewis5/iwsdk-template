      "content": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"jsx\": \"preserve\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"types\": [\"@iwsdk/vite-plugin-dev/client\"]\n  },\n  \"include\": [\"src/**/*.ts\"]\n}\n",
