          "type": "registry:file",
          "target": "~/README.md"
        },
        {
          "path": "registry.json",
          "type": "registry:file",
          "target": "~/registry.json"
        },
        {
          "path": "src/index.ts",
          "type": "registry:file",
          "target": "~/src/index.ts"
